{
  "name": "@isnow890/data4library-mcp",
  "version": "1.0.7",
  "description": "Independent MCP server for the Data4Library Open API",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README-en.md",
    "assets",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "postbuild": "node scripts/copy-data.mjs",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start": "node dist/src/index.js",
    "dev": "npm run build && npm run start",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node test/live-smoke.mjs",
    "test:live:all": "npm run build && node test/live-tools-smoke.mjs",
    "check": "npm test && npm audit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.20.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "library",
    "books",
    "korean-library",
    "public-library",
    "book-search",
    "library-api",
    "도서관정보나루",
    "claude",
    "ai-tools"
  ],
  "author": {
    "name": "isnow890",
    "email": "isnow890@example.com"
  },
  "license": "MIT",
  "bin": {
    "data4library-mcp": "dist/src/index.js"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
